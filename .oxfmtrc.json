{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "printWidth": 120,
  "sortPackageJson": false,
  "ignorePatterns": [
    "package-lock.json",
    "dist/**",
    "qa/.out/**",
    "qa/tools/golden.json",
    "docs/*.html",
    "*.webp",
    "studies/vendor/**",
    "studies/site/sketches/**"
  ]
}
