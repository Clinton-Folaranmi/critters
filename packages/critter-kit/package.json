    "animation",
    "creature",
    "locomotion",
    "gait",
    "inverse-kinematics",
    "procedural-animation",
    "canvas",
    "webgl"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clinton-Folaranmi/critters.git",
    "directory": "packages/critter-kit"
  },
  "homepage": "https://github.com/Clinton-Folaranmi/critters/tree/main/packages/critter-kit#readme",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  }
}
